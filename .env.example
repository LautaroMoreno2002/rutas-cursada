# =========================================================================
# EJEMPLO DE VARIABLES DE ENTORNO PARA EL PROYECTO DE SCRAPING
# Copiar este archivo como ".env" y completar los valores reales.
# =========================================================================

# ---------------------------------------------
# CONFIGURACIÓN DE SOLICITUDES HTTP
# ---------------------------------------------

# Número máximo de reintentos permitidos cuando una solicitud falla
MAX_RETRIES=5

# Tiempo inicial (en segundos) usado para el backoff exponencial
INITIAL_DELAY=3

# ---------------------------------------------
# URLS BASE DEL SCRAPING
# ---------------------------------------------

# Dominio base del sitio (no colocar "/" al final)
URL_BASE=

# URL donde se listan todas las carreras
URL_CARRERAS=

# URL donde se muestra el periodo
URL_PERIODO=

# ---------------------------------------------
# CONFIGURACIÓN DE PAUSAS ENTRE PETICIONES
# ---------------------------------------------

# Pausa entre el scraping de una carrera y otra (segundos)
DELAY_BETWEEN_CAREERS=15

# ---------------------------------------------
# ARCHIVO DE SALIDA
# ---------------------------------------------

# Archivo donde se guardarán los datos extraídos
CARRERAS_FILENAME= ./src/data/carreras.json
PERIODO_EXCEL_FILENAME= ./src/data/periodo.xlsx
PERIODO_PDF_FILENAME= ./src/data/periodo.pdf
PERIODO_CON_MATERIAS_FILENAME= ./src/data/materias_del_periodo.json