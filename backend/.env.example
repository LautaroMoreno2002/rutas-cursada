# =========================================================================
# VARIABLES DE ENTORNO — copiar como backend/.env y completar
# =========================================================================

# ---------------------------------------------
# SCRAPING
# ---------------------------------------------
# Reintentos y backoff exponencial (segundos) cuando una solicitud falla
MAX_RETRIES=5
INITIAL_DELAY=3
# Pausa entre el scraping de una carrera y otra (segundos)
DELAY_BETWEEN_CAREERS=15

# Dominio base del sitio (sin "/" al final), listado de carreras y página del período
URL_BASE=
URL_CARRERAS=
URL_PERIODO=

# Archivos generados (relativos a backend/)
CARRERAS_FILENAME=./data/carreras.json
PERIODO_PDF_FILENAME=./data/periodo.pdf
PERIODO_EXCEL_FILENAME=./data/periodo.xlsx
PERIODO_CON_MATERIAS_FILENAME=./data/materias_del_periodo.json

# ---------------------------------------------
# BASE DE DATOS (MySQL)
# Si DB_HOST queda vacío se usa SQLite en data/rutas_cursada.db (útil para desarrollo)
# ---------------------------------------------
DB_HOST=
DB_PORT=3306
DB_NAME=rutas_cursada
DB_USER=
DB_PASSWORD=
# Alternativa: DATABASE_URL=mysql+pymysql://usuario:clave@localhost:3306/rutas_cursada?charset=utf8mb4

# ---------------------------------------------
# API
# ---------------------------------------------
# Clave para firmar los tokens de sesión (poner algo largo y aleatorio)
JWT_SECRET=cambiar-por-un-secreto-largo
JWT_EXP_HORAS=72
# Token para los endpoints /api/admin (importar carreras y PDFs del período). Vacío = deshabilitado
ADMIN_TOKEN=
# Orígenes permitidos para el front (separados por coma)
CORS_ORIGINS=http://localhost:5173
